# Optional shell exports; no credentials are required for local development.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_DEVICE=cpu
# Run scripts/setup-windows.ps1 to prepare model-config.json and the isolated
# Habibi runtime. Its launcher exports the actual local model/reference paths.
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SECONDS=120
